# GPUMD 5.5 example: heat 300 -> 1200 K, hold, cool 1200 -> 300 K.
# All temperatures/durations below are examples, not a validated annealing schedule.
potential nep.txt
velocity 300 seed 20261017
time_step 1

ensemble npt_scr 300 1200 100 0 0 0 100 100 100 1000
dump_thermo 100
dump_exyz 10000 0
dump_restart 100000
run 100000

ensemble npt_scr 1200 1200 100 0 0 0 100 100 100 1000
dump_thermo 100
dump_exyz 10000 0
dump_restart 100000
run 100000

ensemble npt_scr 1200 300 100 0 0 0 100 100 100 1000
dump_thermo 100
dump_exyz 10000 0
dump_restart 100000
run 100000
